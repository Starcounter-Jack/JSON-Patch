{
    "name": "fast-json-patch",
    "version": "3.1.1",
    "description": "Fast implementation of JSON-Patch (RFC-6902) with duplex (observe changes) capabilities",
    "homepage": "https://github.com/Starcounter-Jack/JSON-Patch",
    "keywords": [
        "json",
        "patch",
        "http",
        "rest"
    ],
    "repository": {
        "type": "git",
        "url": "git://github.com/Starcounter-Jack/JSON-Patch.git"
    },
    "bugs": {
        "url": "https://github.com/Starcounter-Jack/JSON-Patch/issues"
    },
    "author": {
        "name": "Joachim Wester",
        "email": "joachimwester@me.com",
        "url": "http://www.starcounter.com/"
    },
    "license": "MIT",
    "main": "index.js",
    "module": "index.mjs",
    "typings": "index.d.ts",
    "devDependencies": {
        "@playwright/test": "^1.64.0",
        "benchmark": "^2.1.4",
        "chalk": "^2.4.2",
        "esbuild": "^0.28.2",
        "event-target-shim": "^5.0.1",
        "fast-deep-equal": "^2.0.1",
        "http-server": "^14.1.1",
        "jasmine": "^3.4.0",
        "typescript": "~3.5.2"
    },
    "scripts": {
        "tsc": "npm run tsc-common && npm run tsc-module",
        "tsc-common": "tsc",
        "tsc-module": "tsc --module esnext --moduleResolution node --outDir \"module/\" && npm run tsc-to-mjs",
        "tsc-to-mjs": "bash tsc-to-mjs.sh",
        "version": "npm run build && npm run test-dist && git add commonjs module dist",
        "build": "npm run tsc && npm run build-dist",
        "build-dist": "npm run bundle -- --outfile=dist/fast-json-patch.js && npm run bundle -- --minify --outfile=dist/fast-json-patch.min.js",
        "bundle": "esbuild index.js --bundle --format=iife --global-name=jsonpatch --target=es5 --legal-comments=inline --banner:js=\"/*! fast-json-patch, version: $npm_package_version */\"",
        "serve": "http-server -p 5000 --silent",
        "tsc-watch": "tsc -w",
        "test": "npm run tsc && npm run test-core && npm run test-duplex && npm run test-commonjs && npm run test-bundler-import && npm run test-typings",
        "test-commonjs": "jasmine test/spec/commonjs/requireSpec.js",
        "test-bundler-import": "esbuild test/spec/esbuild/importSpec.src.js --bundle --platform=node --main-fields=module,main --outfile=test/spec/esbuild/importSpec.build.js && jasmine test/spec/esbuild/importSpec.build.js",
        "test-typings": "tsc -p test/spec/typings",
        "test-duplex": "node --experimental-modules jasmine-run.mjs test/**/*[sS]pec.mjs",
        "test-core": "node --experimental-modules jasmine-run.mjs 'test/spec/{jsonPatchTestsSpec,coreSpec,validateSpec}.mjs'",
        "test-browser": "npm run build && playwright test",
        "test-dist": "jasmine test/spec/dist/distSpec.js",
        "bench": "npm run bench-core && npm run bench-duplex",
        "bench-core": "node test/spec/coreBenchmark.js",
        "bench-duplex": "node test/spec/coreBenchmark.js && node test/spec/duplexBenchmark.js"
    }
}
